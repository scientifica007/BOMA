{
  "schema": "BOMA-AUTONOMOUS-RESEARCH-PROGRAM-POLICY-001",
  "status": "PROPOSED_GOVERNANCE",
  "date": "2026-08-25",
  "default_posture": "FAIL_CLOSED",
  "authority_unit": "OWNER_AUTHORIZED_RESEARCH_PROGRAM",
  "program_authorization_required": true,
  "active_program_created_by_policy": false,
  "allowed_states": [
    "NO_ACTIVE_PROGRAM",
    "PROGRAM_READY",
    "PREPARING_EXPERIMENT",
    "PLAN_FROZEN",
    "DO",
    "WAITING_CI",
    "RECOVERY_ALLOWED",
    "STUDY",
    "ACT",
    "CLOSING",
    "TRANSITION_GATE",
    "PROGRAM_COMPLETE",
    "OWNER_REQUIRED"
  ],
  "autonomous_actions_when_authorized": [
    "READ_CURRENT_AUTHORITIES",
    "VERIFY_BASELINE",
    "PREPARE_EXPERIMENT_FROM_AUTHORIZED_QUEUE",
    "FREEZE_NEW_EXPERIMENT_PLAN_BEFORE_DO",
    "CREATE_SEPARATE_EXPERIMENT_BRANCH",
    "EXECUTE_FROZEN_PLAN",
    "DIAGNOSE_TECHNICAL_FAILURE",
    "REPAIR_WITHIN_RECOVERY_ENVELOPE",
    "RUN_REQUIRED_VERIFICATION",
    "RECORD_FAILURE_PROVENANCE",
    "WRITE_STUDY",
    "WRITE_ACT",
    "CLOSE_EXPERIMENT",
    "EVALUATE_TRANSITION_GATE",
    "RECORD_NON_SEQUENCE_CRITICAL_CANDIDATE",
    "START_NEXT_AUTHORIZED_EXPERIMENT_AFTER_GATE"
  ],
  "owner_required_conditions": [
    "PROGRAM_QUEUE_REORDER_REQUIRED",
    "SEQUENCE_CRITICAL_EXPERIMENT_INSERTION_REQUIRED",
    "FROZEN_PLAN_CHANGE_REQUIRED_AFTER_DO",
    "SINGLE_CHANGED_FACTOR_CHANGE_REQUIRED",
    "NEW_FOUNDATIONAL_ASSUMPTION_OUTSIDE_SCOPE",
    "NEW_LOGICAL_PRINCIPLE_OUTSIDE_SCOPE",
    "CANONICAL_SELECTION_DECISION_OUTSIDE_PROGRAM_AUTHORITY",
    "ACCEPTANCE_PROMOTION_OUTSIDE_PROGRAM_AUTHORITY",
    "ACCEPTANCE_CONTRACT_CHANGE_OUTSIDE_PROGRAM_AUTHORITY",
    "MATERIAL_AUTHORITY_CONFLICT",
    "UNCLASSIFIABLE_EXACT_VERIFICATION_STATE",
    "BASELINE_INVALIDATED_BY_MAIN_CHANGE",
    "AMBIGUOUS_AUTHORITY"
  ],
  "non_sequence_critical_discovery_policy": "RECORD_CANDIDATE_AND_CONTINUE",
  "sequence_critical_discovery_policy": "RECORD_EVIDENCE_SET_OWNER_REQUIRED_AND_STOP",
  "mathematical_informative_fail_policy": "CLOSE_AND_EVALUATE_TRANSITION_GATE",
  "technical_failure_policy": "RECOVER_AUTONOMOUSLY_IF_FROZEN_PLAN_AND_PROGRAM_SCOPE_REMAIN_UNCHANGED",
  "routine_merge_authority": {
    "default": false,
    "activation": "EXPLICIT_PER_PROGRAM_OWNER_AUTHORIZATION",
    "required_gates": [
      "EXACT_VERIFIED_HEAD",
      "REQUIRED_WORKFLOWS_PASS",
      "FROZEN_PLAN_UNCHANGED",
      "STUDY_ACT_COMPLETE",
      "NO_UNRESOLVED_DEVIATION",
      "NO_UNAUTHORIZED_ACCEPTED_SOURCE_CHANGE",
      "NO_UNAUTHORIZED_SELECTS_CHANGE",
      "NO_UNAUTHORIZED_ACCEPTANCE_PROMOTION"
    ]
  },
  "scheduled_continuation": {
    "semantics": "WAKE_UP_MECHANISM_NOT_SCIENTIFIC_CLOCK",
    "run_until_blocked_by": [
      "WAITING_CI",
      "OWNER_REQUIRED",
      "PROGRAM_COMPLETE"
    ],
    "one_small_subtask_per_wake": false
  },
  "fail_closed_rule": "IF_AUTHORITY_OR_SCOPE_IS_AMBIGUOUS_SET_OWNER_REQUIRED"
}
